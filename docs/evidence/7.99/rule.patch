+/** The airbases held by nations at war with a nation (PLAN 7.99): all, and those with an enemy's wing on them. */
+interface EnemyBases {
+  all: readonly BasePlace[];
+  manned: readonly BasePlace[];
+}
+
+/** An airbase's index + 1 (`world.wingBase`'s) and its place. */
+interface BasePlace {
+  base: number;
+  x: number;
+  y: number;
+}
+
+/** The airbases held by nations at war with `n` (`EnemyBases`); `wingsAt`: the wings at each airbase. */
+function enemyBases(world: World, n: number, wingsAt: Map<number, number[]>): EnemyBases {
+  const all: BasePlace[] = [];
+  const manned: BasePlace[] = [];
+  const nation = world.formations.cols.nation;
+  world.airbases.forEach((b, i) => {
+    if (!world.wars.atWar(n, world.cells.controller[b.cell]!)) return;
+    const [x, y] = world.cellPoint(b.cell);
+    const p = { base: i + 1, x, y };
+    all.push(p);
+    if ((wingsAt.get(i + 1) ?? []).some((o) => world.wars.atWar(n, nation[o]!))) manned.push(p);
+  });
+  return { all, manned };
+}
+
+/**
+ * The place of the airbase of `among` nearest wing `id`'s base within its range, of those with the
+ * fewest of its nation's wings sent there this day (`sent`, by airbase; it counts this wing's), as
+ * `nearestOf`; null for none (PLAN 7.99).
+ */
+function nearestPlace(world: World, id: number, among: readonly BasePlace[], sent: Map<number, number>): [number, number] | null {
+  const at = basePlace(world, world.wingBase.get(id)!);
+  if (!at || among.length === 0) return null;
+  const range = wingRange(world, id);
+  let best: BasePlace | null = null;
+  let bd = Infinity;
+  let bn = Infinity;
+  for (const p of among) {
+    const km = seaKm(world, at[0], at[1], p.x, p.y);
+    if (km > range) continue;
+    const k = sent.get(p.base) ?? 0;
+    if (k < bn || (k === bn && km < bd)) [best, bd, bn] = [p, km, k];
+  }
+  if (!best) return null;
+  sent.set(best.base, bn + 1);
+  return [best.x, best.y];
+}
