+const basinsCache = new WeakMap<World, { tick: number; of: Map<number, Set<number>> }>();
+/** The basins (`basinAt`) of each nation's armed fleets (`fleetPower` > 0), once a tick (derived, not saved). */
+function navalBasins(world: World): Map<number, Set<number>> {
+  const hit = basinsCache.get(world);
+  if (hit && hit.tick === world.tick) return hit.of;
+  const m = new Map<number, Set<number>>();
+  const c = world.formations.cols;
+  world.formations.forEach((id) => {
+    if (!world.isFleet(id) || fleetPower(world, id) <= 0) return;
+    const n = c.nation[id]!;
+    let b = m.get(n);
+    if (!b) m.set(n, (b = new Set()));
+    b.add(basinAt(world, c.x[id]!, c.y[id]!));
+  });
+  basinsCache.set(world, { tick: world.tick, of: m });
+  return m;
+}
+
+/** Whether `n` and `t` both have an armed fleet in one basin (PLAN 7.120). */
+export function navalRivals(world: World, n: number, t: number): boolean {
+  const b = navalBasins(world);
+  const a = b.get(n);
+  const d = b.get(t);
+  if (!a || !d) return false;
+  for (const k of a) if (d.has(k)) return true;
+  return false;
+}
