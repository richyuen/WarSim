+import { describe, expect, it } from 'vitest';
+import { NAVAL_RIVAL, navalRivals, sides, strengths, warUtility } from '../../src/sim/ai/strategic';
+import { NATIONS_1938, SIZE_1938 } from '../../src/sim/scenario1938';
+import { Sim } from '../../src/sim/sim';
+import { destroyFormation } from '../../src/sim/systems/elements';
+import { basinAt } from '../../src/sim/systems/navalCombat';
+import { fleetPower } from '../../src/sim/systems/seaControl';
+import { assets1938 } from '../helpers/earth';
+
+// PLAN 7.120 (ADR-706): the late sea war was the wars of two navies (pairs at war with armed fleets in one
+// basin 2.4 a day in year 1, 0.37 late), not the navies' meeting once at war. A war on a nation with an
+// armed fleet in a basin where the attacker has one weighs NAVAL_RIVAL more. Italy and France in 1938:
+// both navies in the Mediterranean.
+
+const { w: W } = SIZE_1938;
+const id = (tag: string): number => NATIONS_1938.findIndex((n) => n.tag === tag) + 1;
+const ITA = id('ITA');
+const FRA = id('FRA');
+
+describe('a naval rival (PLAN 7.120)', () => {
+  it('weighs NAVAL_RIVAL more while both have an armed fleet in one basin, and nothing once one has none', () => {
+    const s = new Sim({ scenario: '1938', seed: 4602, assets: assets1938(W) });
+    const w = s.world;
+    const c = w.formations.cols;
+    const armed = (n: number): number[] => {
+      const l: number[] = [];
+      w.formations.forEach((f) => {
+        if (w.isFleet(f) && c.nation[f] === n && fleetPower(w, f) > 0) l.push(f);
+      });
+      return l;
+    };
+    const basins = (n: number): Set<number> => new Set(armed(n).map((f) => basinAt(w, c.x[f]!, c.y[f]!)));
+    expect([...basins(ITA)].some((b) => basins(FRA).has(b))).toBe(true);
+    expect(navalRivals(w, ITA, FRA)).toBe(true);
+    expect(navalRivals(w, FRA, ITA)).toBe(true);
+
+    const { withAllies, defence } = sides(w, strengths(w));
+    const attack = withAllies(ITA);
+    const d = defence(FRA);
+    const before = warUtility(w, ITA, FRA, attack, d, 0, 0);
+    expect(before.naval).toBe(NAVAL_RIVAL);
+    expect(before.u).toBeCloseTo(before.strength + before.opportunity + before.claim - before.exhaustion - before.wars + before.pariah + before.restless + NAVAL_RIVAL, 9);
+
+    // France's armed fleets gone: no rival, the same war weighs NAVAL_RIVAL less (the other terms as they were).
+    for (const f of armed(FRA)) destroyFormation(w, f);
+    expect(navalRivals(w, ITA, FRA)).toBe(false);
+    const after = warUtility(w, ITA, FRA, attack, d, 0, 0);
+    expect(after.naval).toBe(0);
+    expect(before.u - after.u).toBeCloseTo(NAVAL_RIVAL, 9);
+  });
+});
