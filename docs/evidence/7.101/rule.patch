+/** The fighter wings that rise against one raid in an hour (PLAN 7.101). */
+export const SCRAMBLE_PER_RAID = 1;
+
+/**
+ * The defence that rises (PLAN 7.101, ADR-672 b): each hour, against each raid (a sortie of a wing
+ * with a mission, on its way out or over its target, by wing id), the idle fighter wing nearest it
+ * of a nation at war with the raider's takes off: an AI nation's fighter wing at an airbase, with no
+ * mission and no sortie, whose range of its base reaches the raid where it is. It patrols over the
+ * raid's target where its range reaches that, else over the raid's place now, as a patrol does
+ * (`patrolHours`); with no mission, it is no raid itself. Up to SCRAMBLE_PER_RAID a raid; the nearest
+ * base first, the lowest wing id on it. Before, nothing on the ground rose: of 120,472 sweeps over the
+ * enemy's airbases 1.0 % came within INTERCEPT_KM of an air battle (PLAN 7.99).
+ */
+export function scramble(world: World): void {
+  if (!world.settings.aiEnabled || world.sorties.size === 0 || !world.rules) return;
+  const c = world.formations.cols;
+  const nc = world.nations.cols;
+  const rules = world.rules;
+  const fighting = world.wars.nations();
+  // The idle fighters, by airbase (ascending ids within each).
+  const idle = new Map<number, number[]>();
+  for (const [id, base] of world.wingBase) {
+    if (base <= 0 || world.sorties.has(id) || world.wingMission.has(id) || !world.formations.has(id)) continue;
+    const n = c.nation[id]!;
+    if (!fighting.has(n) || nc.aiOff[n] === 1 || nc.living[n] !== 1) continue;
+    const t = rules.templates[c.template[id]!]!;
+    if (rules.units[t.elements[0]!.unit]!.cls !== 'fighter') continue;
+    const l = idle.get(base);
+    if (l) l.push(id);
+    else idle.set(base, [id]);
+  }
+  if (idle.size === 0) return;
+  const bases = [...idle.keys()].sort((a, b) => a - b).map((b) => ({ base: b, at: basePlace(world, b)!, wings: idle.get(b)!.sort((x, y) => x - y) }));
+  const w = loopW(world);
+  for (const [raid, s] of [...world.sorties].sort((a, b) => a[0] - b[0])) {
+    if (!world.wingMission.has(raid) || !world.formations.has(raid)) continue;
+    const p = sortieAt(s, world.tick, w);
+    if (p.leg !== Leg.Out && p.leg !== Leg.Over) continue;
+    const rn = c.nation[raid]!;
+    for (let k = 0; k < SCRAMBLE_PER_RAID; k++) {
+      let best = -1;
+      let bestBase: (typeof bases)[number] | null = null;
+      let bd = Infinity;
+      for (const b of bases) {
+        const km = seaKm(world, b.at[0], b.at[1], p.x, p.y);
+        if (km >= bd) continue;
+        const id = b.wings.find((o) => !world.sorties.has(o) && world.wars.atWar(c.nation[o]!, rn) && km <= wingRange(world, o));
+        if (id === undefined) continue;
+        best = id;
+        bestBase = b;
+        bd = km;
+      }
+      if (best < 0 || !bestBase) break;
+      const range = wingRange(world, best);
+      const [b0, b1] = bestBase.at;
+      const toTarget = seaKm(world, b0, b1, s.tx, s.ty);
+      const [tx, ty, km] = toTarget <= range ? [s.tx, s.ty, toTarget] : [p.x, p.y, bd];
+      const kmh = rules.templates[c.template[best]!]!.speedKmh;
+      world.sorties.set(best, { bx: b0, by: b1, tx, ty, launch: world.tick, kmh, km, over: patrolHours(range, kmh, km) });
+    }
+  }
+}
+
 /** Whether `holder` is nation `nation` or of its side: its supply bloc, or fighting beside it. */
 export function ofSide(world: World, nation: number, holder: number): boolean {
   return holder === nation || blocOf(world, holder) === blocOf(world, nation) || world.wars.sameSide(nation, holder);
