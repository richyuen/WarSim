@@ -0,0 +1,62 @@
+import { describe, expect, it } from 'vitest';
+import { SIZE_1938 } from '../../src/sim/scenario1938';
+import { Sim } from '../../src/sim/sim';
+import { airSystem, basePlace, wingRange } from '../../src/sim/systems/air';
+import { seaKm } from '../../src/sim/systems/navalCombat';
+import { legHours, patrolHours } from '../../src/sim/systems/sorties';
+import type { World } from '../../src/sim/world';
+import { assets1938 } from '../helpers/earth';
+import { nationId } from '../helpers/sim1938';
+
+// PLAN 7.101 (ADR-672 b): a defence that rises. Of 120,472 sweeps over the enemy's airbases 1.0 % came
+// within INTERCEPT_KM of an air battle (PLAN 7.99): nothing on the ground took off against a raid. Now,
+// each hour, the idle fighter wing nearest a raid (a sortie of a wing with a mission, out or over its
+// target) of a nation at war with the raider's, whose range reaches it, takes off over the raid's target.
+
+const [GER, POL] = ['GER', 'POL'].map(nationId) as [number, number];
+const cls = (w: World, id: number): string => w.rules!.units[w.rules!.templates[w.formations.cols.template[id]!]!.elements[0]!.unit]!.cls;
+
+/** A German wing over a Polish airbase with a Polish fighter wing on it, idle; the Polish wing. */
+function raid(atWar: boolean): { w: World; raider: number; defender: number; target: [number, number] } {
+  const w: World = new Sim({ scenario: '1938', seed: 1, assets: assets1938(SIZE_1938.w) }).world;
+  const c = w.formations.cols;
+  if (atWar) w.wars.start([GER], [POL], 0);
+  const wings = [...w.wingBase].sort((a, b) => a[0] - b[0]);
+  const defender = wings.find(([id, b]) => b > 0 && c.nation[id] === POL && cls(w, id) === 'fighter')?.[0];
+  const raider = wings.find(([id, b]) => b > 0 && c.nation[id] === GER && cls(w, id) === 'fighter')?.[0];
+  expect(defender, 'a Polish fighter wing at an airbase').toBeDefined();
+  expect(raider, 'a German fighter wing at an airbase').toBeDefined();
+  // Every other wing grounded: the raid and the defender alone.
+  for (const [id] of wings) if (id !== raider) w.wingMission.delete(id);
+  w.sorties.clear();
+  const target = basePlace(w, w.wingBase.get(defender!)!)!;
+  const from = basePlace(w, w.wingBase.get(raider!)!)!;
+  const kmh = w.rules!.templates[c.template[raider!]!]!.speedKmh;
+  const km = seaKm(w, from[0], from[1], target[0], target[1]);
+  w.wingMission.set(raider!, { kind: 'patrol', x: target[0], y: target[1] });
+  // Over its target now, with an hour of its patrol left at the least.
+  const s = { bx: from[0], by: from[1], tx: target[0], ty: target[1], launch: 0, kmh, km, over: Math.max(2, patrolHours(wingRange(w, raider!), kmh, km)) };
+  s.launch = w.tick - legHours(s) - 0.5;
+  w.sorties.set(raider!, s);
+  return { w, raider: raider!, defender: defender!, target };
+}
+
+describe('a defence that rises against a raid (PLAN 7.101)', () => {
+  it('at war, an idle fighter wing takes off over the raid on its airbase', () => {
+    const { w, defender, target } = raid(true);
+    expect(w.sorties.has(defender)).toBe(false);
+    airSystem(w);
+    const s = w.sorties.get(defender);
+    expect(s, 'the Polish fighter rises').toBeDefined();
+    expect([s!.tx, s!.ty]).toEqual(target);
+    expect(s!.launch).toBe(w.tick);
+    // With no mission it is no raid itself (no scramble rises against a scramble).
+    expect(w.wingMission.has(defender)).toBe(false);
+  });
+
+  it('in peace nothing rises', () => {
+    const { w, defender } = raid(false);
+    airSystem(w);
+    expect(w.sorties.has(defender)).toBe(false);
+  });
+});
