@@ -0,0 +1,76 @@
+import { describe, expect, it } from 'vitest';
+import { airAi } from '../../src/sim/ai/air';
+import { SIZE_1938 } from '../../src/sim/scenario1938';
+import { Sim } from '../../src/sim/sim';
+import { kmFromBase, wingRange } from '../../src/sim/systems/air';
+import { destroyFormation } from '../../src/sim/systems/elements';
+import type { World } from '../../src/sim/world';
+import { assets1938 } from '../helpers/earth';
+import { nationId } from '../helpers/sim1938';
+
+// PLAN 7.99, 7.101 (ADR-672 b): the air war followed the land war alone (ADR-377), so after year 1
+// it stood at 0.066 of year 1's (PLAN 7.85). A wing at war with no enemy land formation in range,
+// which does not rebase toward one, flies at the enemy's air or ships within its range: a fighter
+// sweeps over an enemy airbase with the enemy's wings on it first, then a fleet afloat; a striker hits
+// a fleet first, then such an airbase. Never over an airbase with no enemy wing on it (7.99's sweeps
+// there met nothing).
+
+const [GER, POL] = ['GER', 'POL'].map(nationId) as [number, number];
+const cls = (w: World, id: number): string => w.rules!.units[w.rules!.templates[w.formations.cols.template[id]!]!.elements[0]!.unit]!.cls;
+
+describe('the air war at the enemy air with no land forces in range (PLAN 7.99, 7.101)', () => {
+  it('German wings fly at Polish airbases and ships once Poland has no army', () => {
+    const w: World = new Sim({ scenario: '1938', seed: 1, assets: assets1938(SIZE_1938.w) }).world;
+    const c = w.formations.cols;
+    w.wars.start([GER], [POL], 0);
+    // Poland's land forces gone; nothing in contact anywhere.
+    const army: number[] = [];
+    w.formations.forEach((id) => {
+      if (c.nation[id] === POL && !w.isFleet(id) && !w.isWing(id)) army.push(id);
+    });
+    for (const id of army) destroyFormation(w, id);
+    w.formations.forEach((id) => (c.engaged[id] = 0));
+    // Poland's airbases, and those with a Polish wing on them; its fleets afloat.
+    const manned = new Set<number>();
+    for (const [o, b] of w.wingBase) if (b > 0 && w.formations.has(o) && c.nation[o] === POL) manned.add(b);
+    const bases: { base: number; x: number; y: number }[] = [];
+    w.airbases.forEach((b, i) => {
+      if (w.cells.controller[b.cell] !== POL) return;
+      const [x, y] = w.cellPoint(b.cell);
+      bases.push({ base: i + 1, x, y });
+    });
+    expect(manned.size, 'Polish airbases with wings').toBeGreaterThan(0);
+    const fleets: number[] = [];
+    w.formations.forEach((id) => {
+      if (w.isFleet(id) && c.nation[id] === POL && !w.embarked.has(id)) fleets.push(id);
+    });
+    const before = new Map(w.wingBase);
+    airAi(w);
+    let checked = 0;
+    for (const [id, base] of [...w.wingBase].sort((a, b) => a[0] - b[0])) {
+      const k = cls(w, id);
+      if (base <= 0 || c.nation[id] !== GER || !['fighter', 'cas', 'bomber_tac', 'naval_bomber'].includes(k)) continue;
+      expect(base, `wing ${id} stays: no front to rebase toward`).toBe(before.get(id));
+      const range = wingRange(w, id);
+      const inRange = (x: number, y: number): boolean => kmFromBase(w, id, x, y) <= range;
+      const m = w.wingMission.get(id);
+      const anyBase = bases.filter((p) => manned.has(p.base) && inRange(p.x, p.y));
+      const anyFleet = fleets.filter((g) => inRange(c.x[g]!, c.y[g]!));
+      if (anyBase.length === 0 && anyFleet.length === 0) {
+        expect(m, `wing ${id}: nothing in range`).toBeUndefined();
+        continue;
+      }
+      expect(m, `wing ${id} (${k}) with Poland's air or ships in range`).toBeDefined();
+      expect(m!.kind).toBe(k === 'fighter' ? 'patrol' : 'strike');
+      const atBase = bases.find((p) => p.x === m!.x && p.y === m!.y);
+      const atFleet = fleets.find((g) => c.x[g] === m!.x && c.y[g] === m!.y);
+      expect(atBase !== undefined || atFleet !== undefined, `wing ${id} at a Polish airbase or fleet`).toBe(true);
+      if (atBase) expect(manned.has(atBase.base), `wing ${id} over a manned base, not an empty one`).toBe(true);
+      // The order of preference: a fighter at a manned base when one is in range; a striker at a fleet.
+      if (k === 'fighter' && anyBase.length > 0) expect(atBase, `fighter ${id} over a manned base`).toBeDefined();
+      if (k !== 'fighter' && anyFleet.length > 0) expect(atFleet, `striker ${id} at a fleet`).toBeDefined();
+      checked++;
+    }
+    expect(checked, 'German wings with Polish air or ships in range').toBeGreaterThan(2);
+  });
+});
