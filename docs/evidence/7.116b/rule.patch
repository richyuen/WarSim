+++ b/tests/unit/pursuit1938.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, it } from 'vitest';
+import { STAGGER } from '../../src/sim/ai/operational';
+import { cellOf } from '../../src/sim/data/terrain';
+import { neighbours4 } from '../../src/sim/nav/grid';
+import { SIZE_1938 } from '../../src/sim/scenario1938';
+import { Sim } from '../../src/sim/sim';
+import { destroyFormation } from '../../src/sim/systems/elements';
+import { assets1938 } from '../helpers/earth';
+import { addDivision, nationId, runEvents } from '../helpers/sim1938';
+
+// PLAN 7.116b: a sector that attacks with an enemy formation in reach (one its threat counts) marches
+// on that formation's cell, not on the enemy cell by its front nearest its centre: late in a war the
+// fronts are long and thin, and the attack walked past the enemy (docs/evidence/7.116b/measure.md).
+
+const W = SIZE_1938.w;
+const H = SIZE_1938.h;
+
+describe('an attack marches on the enemy formation in reach (PLAN 7.116b)', () => {
+  it('four German divisions on the Lithuanian border are sent at the Lithuanian division standing behind it', () => {
+    const GER = nationId('GER');
+    const LTU = nationId('LIT');
+    const s = new Sim({ scenario: '1938', seed: 1938, assets: assets1938(W) });
+    const w = s.world;
+    const f = w.formations.cols;
+    for (const n of [GER, LTU]) {
+      w.alliances.leave(n);
+      w.alliances.guarantees = w.alliances.guarantees.filter((g) => g.guarantor !== n && g.target !== n);
+    }
+    w.nations.forEach((n) => {
+      if (n !== GER) w.nations.cols.aiOff[n] = 1;
+    });
+    w.nations.cols.aggression[GER] = 0;
+    runEvents(s, 1);
+    w.wars.start([GER], [LTU], w.tick).fightToDeath = [true, true];
+    w.wars.changed();
+    for (const id of w.formations.ids()) destroyFormation(w, id);
+    // East from East Prussia to the first Lithuanian cell, and three cells on: a cell of Lithuania's
+    // that touches no German one, so no attack on the front's edge goes there.
+    const ctl = w.cells.controller;
+    const [kx, ky] = cellOf(20.5, 54.7, W, H).map(Math.floor) as [number, number];
+    let bx = kx;
+    while (ctl[ky * W + bx] !== LTU) bx++;
+    const foeAt = ky * W + bx + 3;
+    expect(ctl[foeAt]).toBe(LTU);
+    const nb: number[] = [];
+    expect(neighbours4(foeAt, W, H, true, nb).some((k) => ctl[k] === GER)).toBe(false);
+    const foe = addDivision(w, LTU, bx + 3.5, ky + 0.5);
+    const ger = Array.from({ length: 4 }, (_, k) => addDivision(w, GER, bx - 1.5, ky - 1 + k + 0.5));
+    // To the hour after Germany's next plan; the Lithuanian stands (its AI is off).
+    do runEvents(s, 1);
+    while (w.tick % 6 !== 1 || ((w.tick - 1) / 6 + GER) % STAGGER !== 0);
+    expect(Math.floor(f.y[foe]!) * W + Math.floor(f.x[foe]!)).toBe(foeAt);
+    const sent = ger.filter((id) => f.moving[id] === 1 && f.targetCell[id] === foeAt);
+    expect(sent.length, 'German divisions sent at the Lithuanian one').toBeGreaterThan(0);
+  });
+});
