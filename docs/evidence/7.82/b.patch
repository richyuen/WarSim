+function armyByLand(world: World): ArmyByLand {
+  const c = world.formations.cols;
+  const w = world.cells.w;
+  const comp = navOf(world).grid.component;
+  const out = new Map<number, Map<number, number>>();
+  world.formations.forEach((id) => {
