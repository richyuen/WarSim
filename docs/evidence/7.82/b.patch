+ */
+function emptyLand(byLand: ArmyByLand, land: number, foes: ReadonlySet<number>, memo: Map<number, boolean>): boolean {
+  let empty = memo.get(land);
+  if (empty !== undefined) return empty;
+  let k = 0;
+  for (const [m, count] of byLand.get(land) ?? []) if (foes.has(m)) k += count;
+  empty = k <= EMPTY_LAND_FORMATIONS;
+  memo.set(land, empty);
+  return empty;
+}
 
