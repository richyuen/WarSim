+/**
+ * A far member's separate peace (PLAN 7.130, ADR-721): each member of `war` but a side's leader and
+ * a puppet whose overlord is on its side counts the days its realm (it and its puppets on the side)
+ * has met the other side on no land front (`frontPairs`); a day on a front, or on which the realm
+ * holds land of the other side or it land of the realm, sets the count to 0. At
+ * MEMBER_FRONTLESS_DAYS the realm leaves the war (`Wars.leave`), with a truce with the other side's
+ * leader and `PeaceSigned` (a = the member, b = that leader); the side's men at the start are scaled
+ * to those who stay, as in `leaveBondedWars`. Not on a side that fights to the death. Nothing is held
+ * between them, so no land changes hands.
+ */
+function separatePeace(world: World, war: War, pairs: ReadonlySet<number>, land: LandCounts, men: Map<number, number>): void {
+  const nc = world.nations.cols;
+  const quiet = (war.quiet ??= {});
+  for (const s of [ATTACKERS, DEFENDERS]) {
+    if (war.fightToDeath[s]) continue;
+    const enemies = war.sides[1 - s]!;
+    for (const m of war.sides[s]!.slice(1)) {
+      const side = war.sides[s]!; // anew: a separate peace before this one left it shorter
+      if (!side.includes(m) || side.includes(nc.overlord[m]!)) continue;
+      const realm = side.filter((x) => x === m || nc.overlord[x] === m);
+      const met = realm.some((r) =>
+        enemies.some((e) => pairs.has(r * 65536 + e) || (land.occupied.get(r * 65536 + e) ?? 0) > 0 || (land.occupied.get(e * 65536 + r) ?? 0) > 0),
+      );
+      const days = met ? 0 : (quiet[m] ?? 0) + 1;
+      if (days < MEMBER_FRONTLESS_DAYS) {
+        if (days > 0) quiet[m] = days;
+        else delete quiet[m];
+        continue;
+      }
+      for (const r of realm) delete quiet[r];
+      const of = (xs: number[]): number => xs.reduce((sum, x) => sum + (men.get(x) ?? 0), 0);
+      const before = of(side);
+      const leader = enemies[0]!;
+      world.wars.leave(war, realm);
+      if (before > 0) war.startMen[s] = war.startMen[s]! * (of(war.sides[s]!) / before);
+      world.wars.truces.push({ a: m, b: leader, untilTick: world.tick + TRUCE_TICKS });
+      world.out.emit(world.tick, EventKind.PeaceSigned, m, leader, NaN, NaN);
+    }
+  }
+}
