+/**
+ * The airbases of nation `nation`'s side joined by ferry flights of a wing of `range` (PLAN
+ * 7.108b): per airbase index, its chain's label (the lowest index + 1 in it), 0 for a base not of
+ * the side. Two bases are of one chain where hops of FERRY_RANGE ranges each lead from one to the
+ * other over bases of the side; room is not weighed.
+ */
+export function ferryChains(world: World, nation: number, range: number): Int32Array {
+  const n = world.airbases.length;
+  const labels = new Int32Array(n);
+  const side: number[] = [];
+  world.airbases.forEach((b, i) => {
+    if (ofSide(world, nation, world.cells.controller[b.cell]!)) side.push(i);
+  });
+  const pts = side.map((i) => world.cellPoint(world.airbases[i]!.cell));
+  const hop = FERRY_RANGE * range;
+  const seen = new Uint8Array(side.length);
+  for (let k = 0; k < side.length; k++) {
+    if (seen[k]) continue;
+    const label = side[k]! + 1;
+    seen[k] = 1;
+    const queue = [k];
+    for (let q = 0; q < queue.length; q++) {
+      const a = queue[q]!;
+      labels[side[a]!] = label;
+      for (let j = 0; j < side.length; j++) {
+        if (seen[j] || seaKm(world, pts[a]![0], pts[a]![1], pts[j]![0], pts[j]![1]) > hop) continue;
+        seen[j] = 1;
+        queue.push(j);
+      }
+    }
+  }
+  return labels;
+}
