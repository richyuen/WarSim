{
  "name": "warsim",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser-based world war grand-strategy simulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:sweep": "vitest run --config vitest.sweep.config.ts",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:sweep && npm run build && npm run e2e && npm run parity",
    "parity": "tsx tools/parity/cli.ts",
    "bench": "tsx tools/bench/run.ts",
    "data": "tsx tools/data/run.ts",
    "sim": "tsx tools/headless/cli.ts",
    "sweep": "tsx tools/sweep/run.ts",
    "verify:phase0": "bash tools/verify-phase0.sh"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "twgl.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "geotiff": "^3.0.5",
    "globals": "^17.13.0",
    "pixi.js": "^8.22.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
